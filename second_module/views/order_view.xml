<odoo>
    <record id="view_my_order_list" model="ir.ui.view">
        <field name="name">my.order.list</field>
        <field name="model">my.order</field>
        <field name="arch" type="xml">
            <list string="Orders">
                <field name="name"/>
                <field name="total_quantity"/>
                <field name="total_amount"/>
            </list>
        </field>
    </record>
    <record id="view_my_order_form" model="ir.ui.view">
        <field name="name">my.order.form</field>
        <field name="model">my.order</field>
        <field name="arch" type="xml">
            <form string="Order">
                <button name="action_confirm" string="Confirm" type="object"
                        invisible="is_confirm" class="btn-primary"/>
                <button name="action_set_draft" string="Set to Draft" type="object"
                        invisible="is_draft" class="btn-secondary"/>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <notebook>
                        <page string="Order Lines">
                            <field name="order_line" mode="list,form">
                                <list>
                                    <field name="product_name" readonly="is_confirm"/>
                                    <field name="quantity" readonly="is_confirm"/>
                                    <field name="unit_price" readonly="is_confirm"/>
                                    <field name="result_price" readonly="is_confirm"/>
                                    <field name="discount"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <field name="product_name" readonly="is_confirm"/>
                                            <field name="quantity" readonly="is_confirm"/>
                                            <field name="unit_price" readonly="is_confirm"/>
                                            <field name="discount"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Summary">
                            <group>
                                <field name="total_quantity" readonly="1"/>
                                <field name="total_amount" readonly="1"/>
                                <field name="average_discount" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_my_order" model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="res_model">my.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_my_order_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_my_order_form')}),
        ]"/>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_my_order_root" name="My Orders"/>
    <menuitem id="menu_my_order" name="Orders" parent="menu_my_order_root" action="action_my_order"/>
</odoo>