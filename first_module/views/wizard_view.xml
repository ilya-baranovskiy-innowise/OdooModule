<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_create_partner_wizard_form" model="ir.ui.view">
        <field name="name">create.partner.wizard.form</field>
        <field name="model">create.partner.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Partner">
                <group>
                    <field name="name" required="1"/>
                    <field name="is_company" required="1"/>
                </group>
                <footer>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                    <button string="Create" type="object" name="action_create_partner" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>