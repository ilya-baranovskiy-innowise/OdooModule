<odoo>
    <record id="view_first_model_form" model="ir.ui.view">
        <field name="name">first.model.form</field>
        <field name="model">first.model</field>
        <field name="arch" type="xml">
            <form string="First Model Form">
                <sheet>
                    <group>
                        <field name="text"/>
                        <field name="check1"/>
                        <field name="check2"/>
                        <field name="check_all"/>
                        <field name="select1"/>
                        <field name="select2"/>
                    </group>
                    <group string="Booleans">
                        <field name="boolean1"/>
                        <field name="boolean2"/>
                        <field name="boolean3"/>
                        <field name="boolean4"/>
                        <field name="boolean5"/>
                        <field name="boolean6"/>
                        <field name="boolean7"/>
                        <field name="boolean8"/>
                        <field name="boolean9"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_first_model_kanban" model="ir.ui.view">
        <field name="name">first.model.kanban</field>
        <field name="model">first.model</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record">
                            <field name="text"/>
                            <div>
                                <field name="check_all"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_first_model_list" model="ir.ui.view">
    <field name="name">first.model.list</field>
    <field name="model">first.model</field>
    <field name="arch" type="xml">
        <list string="First Model List">
            <field name="text"/>
            <field name="check_all"/>
            <field name="boolean1"/>
            <field name="boolean2"/>
            <field name="boolean3"/>
            <field name="boolean4"/>
            <field name="check_all_int"/>
        </list>
    </field>
</record>

    <record id="view_first_model_pivot" model="ir.ui.view">
        <field name="name">first.model.pivot</field>
        <field name="model">first.model</field>
        <field name="arch" type="xml">
            <pivot string="First Model Pivot">
                <field name="check1" type="row"/>
                <field name="boolean1" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="action_first_model" model="ir.actions.act_window">
    <field name="name">First Model</field>
    <field name="res_model">first.model</field>
    <field name="view_mode">kanban,list,form,pivot</field>
    <field name="view_ids" eval="[
        (5, 0, 0),
        (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_first_model_kanban')}),
        (0, 0, {'view_mode': 'list', 'view_id': ref('view_first_model_list')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('view_first_model_form')}),
        (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_first_model_pivot')}),
    ]"/>
    <field name="target">current</field>
</record>

    <menuitem id="menu_first_model_root" name="First Model"/>
    <menuitem id="menu_first_model_kanban" name="Kanban View" parent="menu_first_model_root" action="action_first_model"/>
</odoo>